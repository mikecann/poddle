{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vite/client"
    ],
    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "e2e/**/*.ts",
    "e2e/**/*.mjs",
    "scripts/*.mjs",
    "playwright.config.ts"
  ],
  "exclude": [
    "e2e/.features-gen",
    "e2e/.runtime"
  ]
}
