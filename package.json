{
  "name": "poddle-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "dev:local": "CONVEX_AGENT_MODE=anonymous convex dev",
    "codegen": "convex codegen",
    "deploy": "convex deploy",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p tsconfig.json && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "web:upload:dev": "VITE_PODDLE_TEST_SIGNIN=1 static-hosting upload --dist web/dist --build-command 'npm run web:build'",
    "web:upload:prod": "static-hosting upload --prod --dist web/dist --build-command 'npm run web:build'"
  },
  "dependencies": {
    "@convex-dev/auth": "^2.0.0-beta.0",
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "fractional-indexing": "^4.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.63",
    "jose": "^6.2.13",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
