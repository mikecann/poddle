{
  "name": "poddle-backend",
  "private": true,
  "license": "MIT",
  "homepage": "https://poddle.mikecann.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikecann/poddle"
  },
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "dev:local": "CONVEX_AGENT_MODE=anonymous convex dev",
    "codegen": "convex codegen",
    "deploy": "convex deploy",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p tsconfig.json && tsc --noEmit -p web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run test:bdd-check",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "web:upload:dev": "VITE_PODDLE_TEST_SIGNIN=1 static-hosting upload --dist web/dist --build-command 'npm run web:build'",
    "web:upload:prod": "static-hosting upload --prod --dist web/dist --build-command 'npm run web:build'",
    "test:bdd-check": "node scripts/verify-bdd-pairing.mjs && node scripts/bdd-drift.mjs",
    "test:e2e:remote": "node scripts/e2e-remote.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:web": "node scripts/verify-bdd-pairing.mjs && bddgen && PWTEST_CACHE_DIR=e2e/.runtime/playwright-transform-cache playwright test",
    "test:e2e:ios": "node scripts/verify-bdd-pairing.mjs && node scripts/run-e2e-ios.mjs",
    "e2e:world": "node e2e/world/world.mjs --website"
  },
  "dependencies": {
    "@convex-dev/auth": "^2.0.0-beta.0",
    "@convex-dev/feedback": "file:vendor/convex-dev-feedback-0.0.1.tgz",
    "@convex-dev/static-hosting": "^0.2.1",
    "@sentry/react": "^11.10.0",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "fractional-indexing": "^4.0.0",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@fontsource/poppins": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.63",
    "jsdom": "^29.1.1",
    "playwright-bdd": "^9.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
