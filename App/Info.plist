<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mikecann.poddle</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>poddle</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a voice note with a feature request.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Write out your voice note as you speak, so your request has the words too.</string>
	<key>PoddleConvexURL</key>
	<string>$(PODDLE_CONVEX_URL)</string>
	<key>PoddleSiteURL</key>
	<string>$(PODDLE_SITE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.mikecann.poddle.refresh</string>
	</array>
</dict>
</plist>
