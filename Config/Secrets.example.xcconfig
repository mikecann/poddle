// Copy to Secrets.xcconfig (gitignored), or run scripts/write-secrets.sh to write it.
// xcconfig treats // as a comment, so URLs are written https:/$()/…
PODDLE_CONVEX_URL_DEBUG = https:/$()/your-dev-deployment.convex.cloud
PODDLE_CONVEX_URL_RELEASE = https:/$()/your-prod-deployment.convex.cloud
PODDLE_API_TOKEN = REPLACE_WITH_PODDLE_API_TOKEN
